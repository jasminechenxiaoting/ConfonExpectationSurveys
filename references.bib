@article{manski_rounding_2010,
	title = {Rounding {Probabilistic} {Expectations} in {Surveys}},
	volume = {28},
	issn = {0735-0015},
	url = {https://doi.org/10.1198/jbes.2009.08098},
	doi = {10.1198/jbes.2009.08098},
	abstract = {Rounding is the familiar practice of reporting one value whenever a real number lies in an interval. Uncertainty about the extent of rounding is common when researchers analyze survey responses to numerical questions. The prevalent practice has been to take numerical responses at face value, even though many may in fact be rounded. This article studies the rounding of responses to survey questions that ask persons to state the percent chance that some future event will occur. We analyze data from the Health and Retirement Study and find strong evidence of rounding, with the extent of rounding differing across respondents. We propose use of a person’s response pattern across different questions to infer the person’s rounding practice, the result being interpretation of reported numerical values as interval data. We then bring to bear recent developments on statistical analysis of interval data to characterize the potential consequences of rounding for empirical research. Finally, we propose enrichment of surveys by probing to learn the extent and reasons for rounding.},
	number = {2},
	urldate = {2025-11-22},
	journal = {Journal of Business \& Economic Statistics},
	publisher = {ASA Website},
	author = {Manski, Charles F. and Molinari, Francesca},
