	type = {{SSRN} {Scholarly} {Paper}},
	title = {Overconfidence versus {Rounding} in {Survey}-{Based} {Density} {Forecasts}},
	url = {https://papers.ssrn.com/abstract=3202810},
	doi = {10.2139/ssrn.3202810},
	abstract = {It has been recently documented that survey-based point predictions outperform even the most successful forecasting models. However, corresponding variance forecasts are frequently diagnosed as being heavily distorted. Forecasters who report inconspicuously low ex-ante variances often produce squared forecast errors that are much larger on average. In this paper, we document the novel stylized fact that this variance misalignment is related to the rounding behavior of survey participants. Discarding responses which are strongly rounded provides an easily implementable correction that i) can be carried out in real time, i.e. before outcomes are observed, and ii) delivers a significantly improved match between ex-ante and ex-post forecast variances. According to our estimates, uncertainty about inflation, output growth and unemployment in the U.S. and the Euro area is higher after correcting for the rounding effect. The increase in the share of non-rounded responses in recent years also helps to understand the trajectory of survey-based average uncertainty during the years after the financial and sovereign debt crisis. Our findings are in line with assertions from the previous literature regarding the connection between survey respondents' rounding behavior and their uncertainty about future macroeconomic outcomes.},
	language = {en},
	urldate = {2025-11-25},
	publisher = {Social Science Research Network},
	author = {Glas, Alexander and Hartmann, Matthias},
	month = sep,
	year = {2018},
	keywords = {macroeconomic uncertainty, probabilistic forecasting, rounding, survey data},
}

